{
  "name": "muquifo-software",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "pnpm -r build",
    "start": "pnpm --filter @muquifo/api start:prod",
    "servidor": "pnpm run build && pnpm run db:migrate && pnpm run start",
    "empacotar": "pwsh -NoProfile -File scripts/empacotar.ps1",
    "instalador": "pwsh -NoProfile -File scripts/empacotar.ps1 -Instalador",
    "icones": "node scripts/gerar-icones.mjs",
    "dev:api": "pnpm --filter @muquifo/contracts build && pnpm --filter @muquifo/api start:dev",
    "dev:web": "pnpm --filter @muquifo/contracts build && pnpm --filter @muquifo/web dev",
    "db:generate": "pnpm --filter @muquifo/api db:generate",
    "db:migrate": "pnpm --filter @muquifo/api db:migrate",
    "db:seed": "pnpm --filter @muquifo/api db:seed",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @muquifo/contracts build && pnpm -r test",
    "test:e2e": "pnpm --filter @muquifo/contracts build && pnpm --filter @muquifo/api test:e2e",
    "format": "biome check --write",
    "format:check": "biome check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "^6.0.2"
  }
}
