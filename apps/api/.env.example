# Copie para .env e ajuste. O .env não vai para o git.
DATABASE_URL=postgres://muquifo:muquifo@localhost:5432/muquifo
# Banco só dos testes e2e (pnpm test:e2e), que é esvaziado a cada rodada. O nome precisa terminar em _test.
DATABASE_URL_TEST=postgres://muquifo:muquifo@localhost:5432/muquifo_test
# 0.0.0.0 aceita conexões da rede local (APKs, painel da cozinha). Use 127.0.0.1 para só esta máquina.
HOST=0.0.0.0
PORT=3000
# Origens liberadas para CORS, separadas por vírgula. "*" só em desenvolvimento.
CORS_ORIGINS=*
# Swagger UI em /docs (e o JSON em /docs/json). Desligue se não quiser expor a documentação.
API_DOCS=true
